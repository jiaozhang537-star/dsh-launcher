{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH 启动器",
  "mainBinaryName": "dsh-launcher",
  "version": "0.1.0",
  "identifier": "com.mltz.dshlauncher",
  "build": {
    "beforeDevCommand": "node scripts/pre-dev.cjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "DSH 启动器",
        "width": 850,
        "height": 500,
        "minWidth": 810,
        "minHeight": 470,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "publisher": "imccyu",
    "shortDescription": "DeepSeek Harness（DSH）的图形化启动器",
    "longDescription": "DSH 启动器是 DeepSeek Harness 的图形化外壳：网页端之外的下载、实例隔离、模型厂商、插件市场、技能中心与整合包搬运，全程图形界面，不修改 DSH 本体。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
